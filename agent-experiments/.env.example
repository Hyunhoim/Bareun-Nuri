# Default is mock. Real calls require --provider hcx or --provider qwen.
# HCX-007: use --provider hcx. Keep real keys only in .env.
CLOVASTUDIO_API_KEY=
CLOVASTUDIO_MODEL=HCX-007
CLOVASTUDIO_REASONING_EFFORT=none
CLOVASTUDIO_TEMPERATURE=0
CLOVASTUDIO_MAX_TOKENS=2048
CLOVASTUDIO_TIMEOUT_MS=60000
CLOVASTUDIO_MIN_INTERVAL_MS=8000
QWEN_API_KEY=
# Paste your provider/region's compatible API base ending in /v1 (not /chat/completions).
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-plus
QWEN_ENABLE_THINKING=false
QWEN_TEMPERATURE=0
QWEN_MAX_TOKENS=4096
QWEN_TIMEOUT_MS=60000
MAX_LLM_CALLS=300
# Optional browser channel: msedge (default), chrome, chromium.
BROWSER_CHANNEL=msedge
