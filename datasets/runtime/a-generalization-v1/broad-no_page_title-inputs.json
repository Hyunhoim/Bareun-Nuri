[
  {
    "id": "neced753936c32c",
    "group": "broad-v1:s01",
    "axis": "short",
    "fold": 2,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "현금 거는 사설 테니스 승부방, 오늘 들어올 사람 받음.",
      "context": ""
    }
  },
  {
    "id": "n667a6b4141cfe5",
    "group": "broad-v1:s02",
    "axis": "short",
    "fold": 0,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "성인 비동의 촬영물 팝니다. 원하는 파일 적어서 연락.",
      "context": ""
    }
  },
  {
    "id": "nbc1121a8c9295e",
    "group": "broad-v1:s03",
    "axis": "short",
    "fold": 0,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "돈 넣고 룰렛 하실 분? 제가 여는 방은 당첨 칩 현금 환전됩니다.",
      "context": ""
    }
  },
  {
    "id": "ndcd3428db48085",
    "group": "broad-v1:s04",
    "axis": "short",
    "fold": 2,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "테니스장 빌릴 사람 받음. 코트 대관료만 나눠요.",
      "context": ""
    }
  },
  {
    "id": "n6c01f952f2719f",
    "group": "broad-v1:s05",
    "axis": "short",
    "fold": 1,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "사진 원본 팝니다. 제가 찍은 철새 사진, 사용 허락도 같이 드려요.",
      "context": ""
    }
  },
  {
    "id": "n377989783d85ba",
    "group": "broad-v1:s06",
    "axis": "short",
    "fold": 2,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "환전 거절당했어요. 현금 도박방에 보낸 돈, 어디에 신고해요?",
      "context": ""
    }
  },
  {
    "id": "nac8f24c40cb28f",
    "group": "broad-v1:s07",
    "axis": "short",
    "fold": 0,
    "label": 3,
    "title_index": 0,
    "input": {
      "target": "자리 두 개 남음. 금액 먼저 확인하고 연락.",
      "context": ""
    }
  },
  {
    "id": "nfd2d1ce3929afa",
    "group": "broad-v1:s08",
    "axis": "short",
    "fold": 1,
    "label": 3,
    "title_index": 0,
    "input": {
      "target": "오실 분만 답 주세요. 어제 말한 조건 그대로.",
      "context": ""
    }
  },
  {
    "id": "n980cff66d0bb60",
    "group": "broad-v1:m01",
    "axis": "mixed",
    "fold": 1,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "분리수거 날짜 바뀐 건 확인했습니다. 그리고 제가 현금으로 판돈 받는 사설 카드방을 엽니다. 게임해서 딴 돈은 드리니 참여 원하면 연락해요.",
      "context": ""
    }
  },
  {
    "id": "na87322a635650b",
    "group": "broad-v1:m02",
    "axis": "mixed",
    "fold": 0,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "돈 못 찾는다는 글이 보이네요. 저는 온라인 주사위 도박 회원을 받고 있어요. 판돈을 걸고 당첨금을 찾으실 분에게 제 계정을 연결합니다.",
      "context": ""
    }
  },
  {
    "id": "n377b731d5bd53e",
    "group": "broad-v1:m03",
    "axis": "mixed",
    "fold": 2,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "사생활 보호 얘기는 공감합니다. 그래도 성인 당사자 동의 없이 유출된 녹화 파일을 구매할 분은 제게 따로 주문하세요. 제가 돈 받고 전송합니다.",
      "context": ""
    }
  },
  {
    "id": "nf87ee2f50720cd",
    "group": "broad-v1:m04",
    "axis": "mixed",
    "fold": 2,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "동네 소식 보러 왔다가 묻습니다. 돈을 걸었던 사설 카드방에서 제 신분증까지 요구해요. 더는 참여하지 않고 이미 준 정보를 회수하려면 어떻게 해야 하나요?",
      "context": ""
    }
  },
  {
    "id": "n8a5c8149a33a8d",
    "group": "broad-v1:m05",
    "axis": "mixed",
    "fold": 0,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "지난달 행사 사진 구입 안내는 감사해요. 제가 돈 받고 판매하는 파일은 직접 촬영한 식물 도감 사진뿐입니다. 촬영된 사람의 사생활 자료는 취급하지 않습니다.",
      "context": ""
    }
  },
  {
    "id": "n9b295542f1e4c9",
    "group": "broad-v1:m06",
    "axis": "mixed",
    "fold": 1,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "안내해 준 연락처로 문의했습니다. 사설 도박방에서 돈을 찾아준다는 사람이 선입금을 요구하네요. 그 사람에게 송금하지 않고 피해 접수할 방법을 찾습니다.",
      "context": ""
    }
  },
  {
    "id": "nb288bd444bb610",
    "group": "broad-v1:m07",
    "axis": "mixed",
    "fold": 2,
    "label": 1,
    "title_index": 0,
    "input": {
      "target": "동네 토론 기록입니다. 현금 도박 가입 권유와 성인 사생활 영상 판매를 발견했을 때 바로 재전송하지 말자는 의견이 나왔습니다. 두 사례의 신고 절차를 비교했습니다.",
      "context": ""
    }
  },
  {
    "id": "nac65f850092b90",
    "group": "broad-v1:m08",
    "axis": "mixed",
    "fold": 1,
    "label": 3,
    "title_index": 0,
    "input": {
      "target": "민원 답변은 잘 받았습니다. 그 건 말고 제가 따로 받는 신청은 아직 열려 있어요. 전에 안내받은 분은 그대로 오시면 됩니다.",
      "context": ""
    }
  },
  {
    "id": "n64796b6c01a79d",
    "group": "broad-v1:q01",
    "axis": "quotation",
    "fold": 2,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "“판돈 보내면 참가 처리” 이 조건으로 저희 사설 현금 도박방 새 손님 받습니다.",
      "context": ""
    }
  },
  {
    "id": "n0582467d3dde36",
    "group": "broad-v1:q02",
    "axis": "quotation",
    "fold": 2,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "“성인 유출 원본 있음”이라고 문의하셨죠. 동의 없이 촬영된 그 파일 제가 판매합니다. 대금을 주면 보내겠습니다.",
      "context": ""
    }
  },
  {
    "id": "n311bde7bd8b972",
    "group": "broad-v1:q03",
    "axis": "quotation",
    "fold": 1,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "친구 말로는 “돈 걸고 돌려도 바로 뺀다”네요. 제가 운영하는 사설 슬롯은 현금 환전되니 신규 가입해 주세요.",
      "context": ""
    }
  },
  {
    "id": "na1d3f8d08b42ec",
    "group": "broad-v1:q04",
    "axis": "quotation",
    "fold": 0,
    "label": 1,
    "title_index": 0,
    "input": {
      "target": "“돈을 보내면 도박방 계정을 준다”는 문장을 수업에서 분석했습니다. 송금 약속과 참여 유도를 구분해 밑줄을 그은 과제입니다.",
      "context": ""
    }
  },
  {
    "id": "n13475b85afd8c6",
    "group": "broad-v1:q05",
    "axis": "quotation",
    "fold": 0,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "그 사람이 “성인 사생활 파일을 돈 받고 넘긴다”고 썼어요. 제 영상이고 동의하지 않았습니다. 신고 첨부에 이 문장을 넣어도 될까요?",
      "context": ""
    }
  },
  {
    "id": "ne2937db121dfcd",
    "group": "broad-v1:q06",
    "axis": "quotation",
    "fold": 2,
    "label": 1,
    "title_index": 0,
    "input": {
      "target": "회의록에 “사설 현금 도박방 가입 문구를 지우고 기록은 보관한다”는 처리 의견이 남았습니다. 실제 모집글과 구분해서 보존하기로 했습니다.",
      "context": ""
    }
  },
  {
    "id": "n6ab5788fd0291a",
    "group": "broad-v1:q07",
    "axis": "quotation",
    "fold": 1,
    "label": 1,
    "title_index": 0,
    "input": {
      "target": "기사는 운영자가 “현금 판돈을 입금하라”고 요구했다고 전합니다. 피해자가 돈을 되찾지 못한 경위를 요약한 독서 기록입니다.",
      "context": ""
    }
  },
  {
    "id": "na6b75bdbbb3638",
    "group": "broad-v1:q08",
    "axis": "quotation",
    "fold": 1,
    "label": 3,
    "title_index": 0,
    "input": {
      "target": "“오늘까지 받습니다.” 전달받은 문구는 이게 전부예요.",
      "context": ""
    }
  },
  {
    "id": "n407a8e6b6e677b",
    "group": "broad-v1:o01",
    "axis": "ownership",
    "fold": 2,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "신청은 제게 남겨주세요.",
      "context": "앞 문맥: 저는 현금 판돈으로 겨루는 비공식 온라인 경주 도박을 운영하고 새 이용자를 받고 있습니다."
    }
  },
  {
    "id": "n3c2f174ef19026",
    "group": "broad-v1:o02",
    "axis": "ownership",
    "fold": 0,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "필요한 분께 유료로 드립니다.",
      "context": "앞 문맥: 제가 가진 파일은 성인이 배포를 허락하지 않은 사생활 촬영물입니다. 구매자를 받고 있어요."
    }
  },
  {
    "id": "n5a6f6a6ea94062",
    "group": "broad-v1:o03",
    "axis": "ownership",
    "fold": 1,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "접수 양식 위치 좀 알려주세요.",
      "context": "앞 문맥: 현금 도박 사이트에서 송금을 요구받은 기록을 신고하려고 합니다."
    }
  },
  {
    "id": "na001fac493c5ae",
    "group": "broad-v1:o04",
    "axis": "ownership",
    "fold": 0,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "계좌를 적어도 되나요?",
      "context": "앞 문맥: 취소된 문화센터 수강료를 환불받으려는 신청서 문의입니다."
    }
  },
  {
    "id": "n347be94eab0ea2",
    "group": "broad-v1:o05",
    "axis": "ownership",
    "fold": 1,
    "label": 1,
    "title_index": 0,
    "input": {
      "target": "여기서는 가입과 결제 약속이 핵심 표현입니다.",
      "context": "앞 문맥: 청소년 예방 수업에서 도박 모집 광고의 문장 구조를 분석하는 답안입니다."
    }
  },
  {
    "id": "n1bf7f6b3d9ea41",
    "group": "broad-v1:o06",
    "axis": "ownership",
    "fold": 1,
    "label": 1,
    "title_index": 0,
    "input": {
      "target": "이 말의 원발화자는 판매자입니다.",
      "context": "앞 문맥: 비동의 성인 촬영물 판매를 비판하는 기사에서 인용과 기자의 서술을 구별하는 문제입니다."
    }
  },
  {
    "id": "nc838430fabd70f",
    "group": "broad-v1:o07",
    "axis": "ownership",
    "fold": 2,
    "label": 3,
    "title_index": 0,
    "input": {
      "target": "그쪽으로 연결해 주세요.",
      "context": ""
    }
  },
  {
    "id": "nf7525c3b75af9c",
    "group": "broad-v1:o08",
    "axis": "ownership",
    "fold": 0,
    "label": 3,
    "title_index": 0,
    "input": {
      "target": "확인되면 다음 절차로 갈게요.",
      "context": ""
    }
  },
  {
    "id": "n488f8e3b19a416",
    "group": "broad-v1:l01",
    "axis": "longer",
    "fold": 1,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "안녕하세요. 게시판 이용 규칙과 답변 시간을 읽었고 글을 남깁니다. 지역 시설 안내는 도움이 됐습니다. 덧붙일 일이 있어 길게 씁니다. 제가 운영하는 사설 현금 포커 게임에 참가할 분을 찾습니다. 판돈을 받아 게임한 뒤 남은 칩과 당첨분을 현금으로 돌려드립니다. 신청은 답글로 받고 있으니 이용할 분은 연락 바랍니다.",
      "context": ""
    }
  },
  {
    "id": "nf117c1ded050bf",
    "group": "broad-v1:l02",
    "axis": "longer",
    "fold": 0,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "상담 글을 여러 개 읽으니 피해가 많군요. 제 경우는 새 손님을 받아 운영을 이어가려는 글입니다. 성인들이 유포를 허락하지 않은 개인 촬영 영상을 보관 중이고, 돈을 지불하는 구매자에게 묶음으로 전달합니다. 파일을 주문할 사람은 제게 연락하세요. 문의하신 분께 제가 결제 안내를 하겠습니다.",
      "context": ""
    }
  },
  {
    "id": "n5b264676ef255a",
    "group": "broad-v1:l03",
    "axis": "longer",
    "fold": 1,
    "label": 0,
    "title_index": 0,
    "input": {
      "target": "회의실 대관 문의에 대한 답변은 확인했습니다. 이제 다른 안내를 남깁니다. 저는 현금으로 참가 금액을 내고 경기 승부를 맞히는 사설방을 운영합니다. 적중하면 돈으로 정산하고 새 참가 신청도 받습니다. 이번 경기에 들어갈 이용자는 답장을 주시면 제가 가입을 처리하겠습니다.",
      "context": ""
    }
  },
  {
    "id": "n1d6e271ec3b82d",
    "group": "broad-v1:l04",
    "axis": "longer",
    "fold": 2,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "어디에 글을 올려야 할지 몰라 여기 적습니다. 현금으로 참가 금액을 내고 경기 승부를 맞히면 돈을 준다는 사람을 만났습니다. 가입을 처리해 준다기에 송금한 뒤부터 답이 없습니다. 새 참가자를 데려오라는 연락만 남았습니다. 누굴 데려갈 생각은 없고, 송금 기록을 제출해서 피해 상담을 받고 싶습니다.",
      "context": ""
    }
  },
  {
    "id": "n481ce8906ca07c",
    "group": "broad-v1:l05",
    "axis": "longer",
    "fold": 1,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "자료를 받을 수 있다는 글에 관해 문의합니다. 저는 성인이고 제 사생활이 촬영된 것을 뒤늦게 알았습니다. 공개를 허락하지 않았는데 누군가 묶음으로 판매한다고 합니다. 증거를 보관하려고 다시 파일을 받아야 하는지 걱정입니다. 다른 사람에게 전달하지 않고 삭제 지원을 신청할 방법을 알려주세요.",
      "context": ""
    }
  },
  {
    "id": "n10f4522c16efde",
    "group": "broad-v1:l06",
    "axis": "longer",
    "fold": 0,
    "label": 2,
    "title_index": 0,
    "input": {
      "target": "마을 기록 사진집의 주문을 받습니다. 주민들의 공개 동의를 받은 행사 사진과 제가 찍은 건물 사진을 넣었습니다. 판매 금액은 인쇄비로 사용하고 신청자에게 책을 전달합니다. 사진 파일의 추가 배포를 원치 않은 주민은 수록하지 않았습니다. 구입 신청과 취소 문의를 함께 받고 있습니다.",
      "context": ""
    }
  },
  {
    "id": "n70847a6176e370",
    "group": "broad-v1:l07",
    "axis": "longer",
    "fold": 0,
    "label": 1,
    "title_index": 0,
    "input": {
      "target": "시민 강좌 토론 기록을 남깁니다. 발표자는 사설 도박 운영자가 가입과 현금 정산을 약속하며 참가자를 모은다고 설명했습니다. 참석자들은 해당 문구를 직접 홍보하는 것과 증거로 기록하는 것을 구분해야 한다고 말했습니다. 이 글은 강좌 내용의 요약이며, 마지막에는 피해 상담 창구를 확인하는 과제가 제시됐습니다.",
      "context": ""
    }
  },
  {
    "id": "ne9c4c2960827b8",
    "group": "broad-v1:l08",
    "axis": "longer",
    "fold": 2,
    "label": 3,
    "title_index": 0,
    "input": {
      "target": "답변 기다리다 다시 씁니다. 지난번 안내에 있던 방식으로 진행하려고 합니다. 비용은 그때 들었던 대로 준비할 수 있고, 확인 후 접수를 해 주시면 됩니다. 받는 쪽 정보가 바뀌었으면 따로 알려주세요. 우선 이 글에는 전에 말씀드린 건을 계속하겠다는 의사만 남깁니다.",
      "context": ""
    }
  },
  {
    "id": "n0ce3a137587058",
    "group": "broad-v1:s01",
    "axis": "short",
    "fold": 2,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "현금 거는 사설 테니스 승부방, 오늘 들어올 사람 받음.",
      "context": ""
    }
  },
  {
    "id": "nac4145ade39cef",
    "group": "broad-v1:s02",
    "axis": "short",
    "fold": 0,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "성인 비동의 촬영물 팝니다. 원하는 파일 적어서 연락.",
      "context": ""
    }
  },
  {
    "id": "ne0df75a5f5ab55",
    "group": "broad-v1:s03",
    "axis": "short",
    "fold": 0,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "돈 넣고 룰렛 하실 분? 제가 여는 방은 당첨 칩 현금 환전됩니다.",
      "context": ""
    }
  },
  {
    "id": "n7547e70a07427c",
    "group": "broad-v1:s04",
    "axis": "short",
    "fold": 2,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "테니스장 빌릴 사람 받음. 코트 대관료만 나눠요.",
      "context": ""
    }
  },
  {
    "id": "n8777701f14ec9b",
    "group": "broad-v1:s05",
    "axis": "short",
    "fold": 1,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "사진 원본 팝니다. 제가 찍은 철새 사진, 사용 허락도 같이 드려요.",
      "context": ""
    }
  },
  {
    "id": "n22c3d0afd80893",
    "group": "broad-v1:s06",
    "axis": "short",
    "fold": 2,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "환전 거절당했어요. 현금 도박방에 보낸 돈, 어디에 신고해요?",
      "context": ""
    }
  },
  {
    "id": "n43e6473e038116",
    "group": "broad-v1:s07",
    "axis": "short",
    "fold": 0,
    "label": 3,
    "title_index": 1,
    "input": {
      "target": "자리 두 개 남음. 금액 먼저 확인하고 연락.",
      "context": ""
    }
  },
  {
    "id": "n8e5148f4f90fee",
    "group": "broad-v1:s08",
    "axis": "short",
    "fold": 1,
    "label": 3,
    "title_index": 1,
    "input": {
      "target": "오실 분만 답 주세요. 어제 말한 조건 그대로.",
      "context": ""
    }
  },
  {
    "id": "ne3c03adc3f4bfe",
    "group": "broad-v1:m01",
    "axis": "mixed",
    "fold": 1,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "분리수거 날짜 바뀐 건 확인했습니다. 그리고 제가 현금으로 판돈 받는 사설 카드방을 엽니다. 게임해서 딴 돈은 드리니 참여 원하면 연락해요.",
      "context": ""
    }
  },
  {
    "id": "nd9bbe29074ddb7",
    "group": "broad-v1:m02",
    "axis": "mixed",
    "fold": 0,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "돈 못 찾는다는 글이 보이네요. 저는 온라인 주사위 도박 회원을 받고 있어요. 판돈을 걸고 당첨금을 찾으실 분에게 제 계정을 연결합니다.",
      "context": ""
    }
  },
  {
    "id": "nf9795a1b69121c",
    "group": "broad-v1:m03",
    "axis": "mixed",
    "fold": 2,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "사생활 보호 얘기는 공감합니다. 그래도 성인 당사자 동의 없이 유출된 녹화 파일을 구매할 분은 제게 따로 주문하세요. 제가 돈 받고 전송합니다.",
      "context": ""
    }
  },
  {
    "id": "ndbed100712fe5a",
    "group": "broad-v1:m04",
    "axis": "mixed",
    "fold": 2,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "동네 소식 보러 왔다가 묻습니다. 돈을 걸었던 사설 카드방에서 제 신분증까지 요구해요. 더는 참여하지 않고 이미 준 정보를 회수하려면 어떻게 해야 하나요?",
      "context": ""
    }
  },
  {
    "id": "n7339eb212948e7",
    "group": "broad-v1:m05",
    "axis": "mixed",
    "fold": 0,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "지난달 행사 사진 구입 안내는 감사해요. 제가 돈 받고 판매하는 파일은 직접 촬영한 식물 도감 사진뿐입니다. 촬영된 사람의 사생활 자료는 취급하지 않습니다.",
      "context": ""
    }
  },
  {
    "id": "nd2bc84b9940774",
    "group": "broad-v1:m06",
    "axis": "mixed",
    "fold": 1,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "안내해 준 연락처로 문의했습니다. 사설 도박방에서 돈을 찾아준다는 사람이 선입금을 요구하네요. 그 사람에게 송금하지 않고 피해 접수할 방법을 찾습니다.",
      "context": ""
    }
  },
  {
    "id": "nfba70f832bdddc",
    "group": "broad-v1:m07",
    "axis": "mixed",
    "fold": 2,
    "label": 1,
    "title_index": 1,
    "input": {
      "target": "동네 토론 기록입니다. 현금 도박 가입 권유와 성인 사생활 영상 판매를 발견했을 때 바로 재전송하지 말자는 의견이 나왔습니다. 두 사례의 신고 절차를 비교했습니다.",
      "context": ""
    }
  },
  {
    "id": "n0b86d8cf10bf28",
    "group": "broad-v1:m08",
    "axis": "mixed",
    "fold": 1,
    "label": 3,
    "title_index": 1,
    "input": {
      "target": "민원 답변은 잘 받았습니다. 그 건 말고 제가 따로 받는 신청은 아직 열려 있어요. 전에 안내받은 분은 그대로 오시면 됩니다.",
      "context": ""
    }
  },
  {
    "id": "n68c83c50931834",
    "group": "broad-v1:q01",
    "axis": "quotation",
    "fold": 2,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "“판돈 보내면 참가 처리” 이 조건으로 저희 사설 현금 도박방 새 손님 받습니다.",
      "context": ""
    }
  },
  {
    "id": "nfcca939ab9bed6",
    "group": "broad-v1:q02",
    "axis": "quotation",
    "fold": 2,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "“성인 유출 원본 있음”이라고 문의하셨죠. 동의 없이 촬영된 그 파일 제가 판매합니다. 대금을 주면 보내겠습니다.",
      "context": ""
    }
  },
  {
    "id": "n390bede3144940",
    "group": "broad-v1:q03",
    "axis": "quotation",
    "fold": 1,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "친구 말로는 “돈 걸고 돌려도 바로 뺀다”네요. 제가 운영하는 사설 슬롯은 현금 환전되니 신규 가입해 주세요.",
      "context": ""
    }
  },
  {
    "id": "n6be6224e513595",
    "group": "broad-v1:q04",
    "axis": "quotation",
    "fold": 0,
    "label": 1,
    "title_index": 1,
    "input": {
      "target": "“돈을 보내면 도박방 계정을 준다”는 문장을 수업에서 분석했습니다. 송금 약속과 참여 유도를 구분해 밑줄을 그은 과제입니다.",
      "context": ""
    }
  },
  {
    "id": "nd28041d3f99a3b",
    "group": "broad-v1:q05",
    "axis": "quotation",
    "fold": 0,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "그 사람이 “성인 사생활 파일을 돈 받고 넘긴다”고 썼어요. 제 영상이고 동의하지 않았습니다. 신고 첨부에 이 문장을 넣어도 될까요?",
      "context": ""
    }
  },
  {
    "id": "n1f12259f4e7728",
    "group": "broad-v1:q06",
    "axis": "quotation",
    "fold": 2,
    "label": 1,
    "title_index": 1,
    "input": {
      "target": "회의록에 “사설 현금 도박방 가입 문구를 지우고 기록은 보관한다”는 처리 의견이 남았습니다. 실제 모집글과 구분해서 보존하기로 했습니다.",
      "context": ""
    }
  },
  {
    "id": "na4626a3247f75c",
    "group": "broad-v1:q07",
    "axis": "quotation",
    "fold": 1,
    "label": 1,
    "title_index": 1,
    "input": {
      "target": "기사는 운영자가 “현금 판돈을 입금하라”고 요구했다고 전합니다. 피해자가 돈을 되찾지 못한 경위를 요약한 독서 기록입니다.",
      "context": ""
    }
  },
  {
    "id": "n772dc451ca4089",
    "group": "broad-v1:q08",
    "axis": "quotation",
    "fold": 1,
    "label": 3,
    "title_index": 1,
    "input": {
      "target": "“오늘까지 받습니다.” 전달받은 문구는 이게 전부예요.",
      "context": ""
    }
  },
  {
    "id": "n6630484e03ef91",
    "group": "broad-v1:o01",
    "axis": "ownership",
    "fold": 2,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "신청은 제게 남겨주세요.",
      "context": "앞 문맥: 저는 현금 판돈으로 겨루는 비공식 온라인 경주 도박을 운영하고 새 이용자를 받고 있습니다."
    }
  },
  {
    "id": "nb5017443adec1e",
    "group": "broad-v1:o02",
    "axis": "ownership",
    "fold": 0,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "필요한 분께 유료로 드립니다.",
      "context": "앞 문맥: 제가 가진 파일은 성인이 배포를 허락하지 않은 사생활 촬영물입니다. 구매자를 받고 있어요."
    }
  },
  {
    "id": "nab79d81aa067d4",
    "group": "broad-v1:o03",
    "axis": "ownership",
    "fold": 1,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "접수 양식 위치 좀 알려주세요.",
      "context": "앞 문맥: 현금 도박 사이트에서 송금을 요구받은 기록을 신고하려고 합니다."
    }
  },
  {
    "id": "n3713604977f9eb",
    "group": "broad-v1:o04",
    "axis": "ownership",
    "fold": 0,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "계좌를 적어도 되나요?",
      "context": "앞 문맥: 취소된 문화센터 수강료를 환불받으려는 신청서 문의입니다."
    }
  },
  {
    "id": "n830db57095a1a7",
    "group": "broad-v1:o05",
    "axis": "ownership",
    "fold": 1,
    "label": 1,
    "title_index": 1,
    "input": {
      "target": "여기서는 가입과 결제 약속이 핵심 표현입니다.",
      "context": "앞 문맥: 청소년 예방 수업에서 도박 모집 광고의 문장 구조를 분석하는 답안입니다."
    }
  },
  {
    "id": "nac67b9e25597fa",
    "group": "broad-v1:o06",
    "axis": "ownership",
    "fold": 1,
    "label": 1,
    "title_index": 1,
    "input": {
      "target": "이 말의 원발화자는 판매자입니다.",
      "context": "앞 문맥: 비동의 성인 촬영물 판매를 비판하는 기사에서 인용과 기자의 서술을 구별하는 문제입니다."
    }
  },
  {
    "id": "nd90cbcf725fea7",
    "group": "broad-v1:o07",
    "axis": "ownership",
    "fold": 2,
    "label": 3,
    "title_index": 1,
    "input": {
      "target": "그쪽으로 연결해 주세요.",
      "context": ""
    }
  },
  {
    "id": "nc782b7bf557eb2",
    "group": "broad-v1:o08",
    "axis": "ownership",
    "fold": 0,
    "label": 3,
    "title_index": 1,
    "input": {
      "target": "확인되면 다음 절차로 갈게요.",
      "context": ""
    }
  },
  {
    "id": "n5781d5e4a9e871",
    "group": "broad-v1:l01",
    "axis": "longer",
    "fold": 1,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "안녕하세요. 게시판 이용 규칙과 답변 시간을 읽었고 글을 남깁니다. 지역 시설 안내는 도움이 됐습니다. 덧붙일 일이 있어 길게 씁니다. 제가 운영하는 사설 현금 포커 게임에 참가할 분을 찾습니다. 판돈을 받아 게임한 뒤 남은 칩과 당첨분을 현금으로 돌려드립니다. 신청은 답글로 받고 있으니 이용할 분은 연락 바랍니다.",
      "context": ""
    }
  },
  {
    "id": "n8a7b5ea74911ae",
    "group": "broad-v1:l02",
    "axis": "longer",
    "fold": 0,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "상담 글을 여러 개 읽으니 피해가 많군요. 제 경우는 새 손님을 받아 운영을 이어가려는 글입니다. 성인들이 유포를 허락하지 않은 개인 촬영 영상을 보관 중이고, 돈을 지불하는 구매자에게 묶음으로 전달합니다. 파일을 주문할 사람은 제게 연락하세요. 문의하신 분께 제가 결제 안내를 하겠습니다.",
      "context": ""
    }
  },
  {
    "id": "n9fdb26fd0a62a8",
    "group": "broad-v1:l03",
    "axis": "longer",
    "fold": 1,
    "label": 0,
    "title_index": 1,
    "input": {
      "target": "회의실 대관 문의에 대한 답변은 확인했습니다. 이제 다른 안내를 남깁니다. 저는 현금으로 참가 금액을 내고 경기 승부를 맞히는 사설방을 운영합니다. 적중하면 돈으로 정산하고 새 참가 신청도 받습니다. 이번 경기에 들어갈 이용자는 답장을 주시면 제가 가입을 처리하겠습니다.",
      "context": ""
    }
  },
  {
    "id": "n7105d7c2dda5e8",
    "group": "broad-v1:l04",
    "axis": "longer",
    "fold": 2,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "어디에 글을 올려야 할지 몰라 여기 적습니다. 현금으로 참가 금액을 내고 경기 승부를 맞히면 돈을 준다는 사람을 만났습니다. 가입을 처리해 준다기에 송금한 뒤부터 답이 없습니다. 새 참가자를 데려오라는 연락만 남았습니다. 누굴 데려갈 생각은 없고, 송금 기록을 제출해서 피해 상담을 받고 싶습니다.",
      "context": ""
    }
  },
  {
    "id": "n1d654354b122a2",
    "group": "broad-v1:l05",
    "axis": "longer",
    "fold": 1,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "자료를 받을 수 있다는 글에 관해 문의합니다. 저는 성인이고 제 사생활이 촬영된 것을 뒤늦게 알았습니다. 공개를 허락하지 않았는데 누군가 묶음으로 판매한다고 합니다. 증거를 보관하려고 다시 파일을 받아야 하는지 걱정입니다. 다른 사람에게 전달하지 않고 삭제 지원을 신청할 방법을 알려주세요.",
      "context": ""
    }
  },
  {
    "id": "nc618e71ec4ac9d",
    "group": "broad-v1:l06",
    "axis": "longer",
    "fold": 0,
    "label": 2,
    "title_index": 1,
    "input": {
      "target": "마을 기록 사진집의 주문을 받습니다. 주민들의 공개 동의를 받은 행사 사진과 제가 찍은 건물 사진을 넣었습니다. 판매 금액은 인쇄비로 사용하고 신청자에게 책을 전달합니다. 사진 파일의 추가 배포를 원치 않은 주민은 수록하지 않았습니다. 구입 신청과 취소 문의를 함께 받고 있습니다.",
      "context": ""
    }
  },
  {
    "id": "nf90da4947df1c6",
    "group": "broad-v1:l07",
    "axis": "longer",
    "fold": 0,
    "label": 1,
    "title_index": 1,
    "input": {
      "target": "시민 강좌 토론 기록을 남깁니다. 발표자는 사설 도박 운영자가 가입과 현금 정산을 약속하며 참가자를 모은다고 설명했습니다. 참석자들은 해당 문구를 직접 홍보하는 것과 증거로 기록하는 것을 구분해야 한다고 말했습니다. 이 글은 강좌 내용의 요약이며, 마지막에는 피해 상담 창구를 확인하는 과제가 제시됐습니다.",
      "context": ""
    }
  },
  {
    "id": "n17c10ea5487aeb",
    "group": "broad-v1:l08",
    "axis": "longer",
    "fold": 2,
    "label": 3,
    "title_index": 1,
    "input": {
      "target": "답변 기다리다 다시 씁니다. 지난번 안내에 있던 방식으로 진행하려고 합니다. 비용은 그때 들었던 대로 준비할 수 있고, 확인 후 접수를 해 주시면 됩니다. 받는 쪽 정보가 바뀌었으면 따로 알려주세요. 우선 이 글에는 전에 말씀드린 건을 계속하겠다는 의사만 남깁니다.",
      "context": ""
    }
  },
  {
    "id": "n6a00cb14713648",
    "group": "broad-v1:s01",
    "axis": "short",
    "fold": 2,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "현금 거는 사설 테니스 승부방, 오늘 들어올 사람 받음.",
      "context": ""
    }
  },
  {
    "id": "n7522a736a02225",
    "group": "broad-v1:s02",
    "axis": "short",
    "fold": 0,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "성인 비동의 촬영물 팝니다. 원하는 파일 적어서 연락.",
      "context": ""
    }
  },
  {
    "id": "n70725e3c173419",
    "group": "broad-v1:s03",
    "axis": "short",
    "fold": 0,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "돈 넣고 룰렛 하실 분? 제가 여는 방은 당첨 칩 현금 환전됩니다.",
      "context": ""
    }
  },
  {
    "id": "n6743646fb78392",
    "group": "broad-v1:s04",
    "axis": "short",
    "fold": 2,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "테니스장 빌릴 사람 받음. 코트 대관료만 나눠요.",
      "context": ""
    }
  },
  {
    "id": "n8b898656659006",
    "group": "broad-v1:s05",
    "axis": "short",
    "fold": 1,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "사진 원본 팝니다. 제가 찍은 철새 사진, 사용 허락도 같이 드려요.",
      "context": ""
    }
  },
  {
    "id": "nc0d9902c8a681e",
    "group": "broad-v1:s06",
    "axis": "short",
    "fold": 2,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "환전 거절당했어요. 현금 도박방에 보낸 돈, 어디에 신고해요?",
      "context": ""
    }
  },
  {
    "id": "n232426155e8e0a",
    "group": "broad-v1:s07",
    "axis": "short",
    "fold": 0,
    "label": 3,
    "title_index": 2,
    "input": {
      "target": "자리 두 개 남음. 금액 먼저 확인하고 연락.",
      "context": ""
    }
  },
  {
    "id": "n84f0847248c61f",
    "group": "broad-v1:s08",
    "axis": "short",
    "fold": 1,
    "label": 3,
    "title_index": 2,
    "input": {
      "target": "오실 분만 답 주세요. 어제 말한 조건 그대로.",
      "context": ""
    }
  },
  {
    "id": "n9436c18342c0ba",
    "group": "broad-v1:m01",
    "axis": "mixed",
    "fold": 1,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "분리수거 날짜 바뀐 건 확인했습니다. 그리고 제가 현금으로 판돈 받는 사설 카드방을 엽니다. 게임해서 딴 돈은 드리니 참여 원하면 연락해요.",
      "context": ""
    }
  },
  {
    "id": "n34342daa7c67da",
    "group": "broad-v1:m02",
    "axis": "mixed",
    "fold": 0,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "돈 못 찾는다는 글이 보이네요. 저는 온라인 주사위 도박 회원을 받고 있어요. 판돈을 걸고 당첨금을 찾으실 분에게 제 계정을 연결합니다.",
      "context": ""
    }
  },
  {
    "id": "n91c25e07d21b48",
    "group": "broad-v1:m03",
    "axis": "mixed",
    "fold": 2,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "사생활 보호 얘기는 공감합니다. 그래도 성인 당사자 동의 없이 유출된 녹화 파일을 구매할 분은 제게 따로 주문하세요. 제가 돈 받고 전송합니다.",
      "context": ""
    }
  },
  {
    "id": "nb3bb17430ab804",
    "group": "broad-v1:m04",
    "axis": "mixed",
    "fold": 2,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "동네 소식 보러 왔다가 묻습니다. 돈을 걸었던 사설 카드방에서 제 신분증까지 요구해요. 더는 참여하지 않고 이미 준 정보를 회수하려면 어떻게 해야 하나요?",
      "context": ""
    }
  },
  {
    "id": "n5b0d64bbdb496b",
    "group": "broad-v1:m05",
    "axis": "mixed",
    "fold": 0,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "지난달 행사 사진 구입 안내는 감사해요. 제가 돈 받고 판매하는 파일은 직접 촬영한 식물 도감 사진뿐입니다. 촬영된 사람의 사생활 자료는 취급하지 않습니다.",
      "context": ""
    }
  },
  {
    "id": "n5bcb773b27dbb4",
    "group": "broad-v1:m06",
    "axis": "mixed",
    "fold": 1,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "안내해 준 연락처로 문의했습니다. 사설 도박방에서 돈을 찾아준다는 사람이 선입금을 요구하네요. 그 사람에게 송금하지 않고 피해 접수할 방법을 찾습니다.",
      "context": ""
    }
  },
  {
    "id": "n7b4319319b7f21",
    "group": "broad-v1:m07",
    "axis": "mixed",
    "fold": 2,
    "label": 1,
    "title_index": 2,
    "input": {
      "target": "동네 토론 기록입니다. 현금 도박 가입 권유와 성인 사생활 영상 판매를 발견했을 때 바로 재전송하지 말자는 의견이 나왔습니다. 두 사례의 신고 절차를 비교했습니다.",
      "context": ""
    }
  },
  {
    "id": "ne20b1fbd1d4fe2",
    "group": "broad-v1:m08",
    "axis": "mixed",
    "fold": 1,
    "label": 3,
    "title_index": 2,
    "input": {
      "target": "민원 답변은 잘 받았습니다. 그 건 말고 제가 따로 받는 신청은 아직 열려 있어요. 전에 안내받은 분은 그대로 오시면 됩니다.",
      "context": ""
    }
  },
  {
    "id": "n8e1bde8d4cc9ab",
    "group": "broad-v1:q01",
    "axis": "quotation",
    "fold": 2,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "“판돈 보내면 참가 처리” 이 조건으로 저희 사설 현금 도박방 새 손님 받습니다.",
      "context": ""
    }
  },
  {
    "id": "naeea819d281b11",
    "group": "broad-v1:q02",
    "axis": "quotation",
    "fold": 2,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "“성인 유출 원본 있음”이라고 문의하셨죠. 동의 없이 촬영된 그 파일 제가 판매합니다. 대금을 주면 보내겠습니다.",
      "context": ""
    }
  },
  {
    "id": "nc7756ac48a850a",
    "group": "broad-v1:q03",
    "axis": "quotation",
    "fold": 1,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "친구 말로는 “돈 걸고 돌려도 바로 뺀다”네요. 제가 운영하는 사설 슬롯은 현금 환전되니 신규 가입해 주세요.",
      "context": ""
    }
  },
  {
    "id": "na262c7df241c72",
    "group": "broad-v1:q04",
    "axis": "quotation",
    "fold": 0,
    "label": 1,
    "title_index": 2,
    "input": {
      "target": "“돈을 보내면 도박방 계정을 준다”는 문장을 수업에서 분석했습니다. 송금 약속과 참여 유도를 구분해 밑줄을 그은 과제입니다.",
      "context": ""
    }
  },
  {
    "id": "nc87a38d7cef9c9",
    "group": "broad-v1:q05",
    "axis": "quotation",
    "fold": 0,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "그 사람이 “성인 사생활 파일을 돈 받고 넘긴다”고 썼어요. 제 영상이고 동의하지 않았습니다. 신고 첨부에 이 문장을 넣어도 될까요?",
      "context": ""
    }
  },
  {
    "id": "n433b3b48018588",
    "group": "broad-v1:q06",
    "axis": "quotation",
    "fold": 2,
    "label": 1,
    "title_index": 2,
    "input": {
      "target": "회의록에 “사설 현금 도박방 가입 문구를 지우고 기록은 보관한다”는 처리 의견이 남았습니다. 실제 모집글과 구분해서 보존하기로 했습니다.",
      "context": ""
    }
  },
  {
    "id": "n036b9bb7a9b674",
    "group": "broad-v1:q07",
    "axis": "quotation",
    "fold": 1,
    "label": 1,
    "title_index": 2,
    "input": {
      "target": "기사는 운영자가 “현금 판돈을 입금하라”고 요구했다고 전합니다. 피해자가 돈을 되찾지 못한 경위를 요약한 독서 기록입니다.",
      "context": ""
    }
  },
  {
    "id": "n7c82ddd51d22bd",
    "group": "broad-v1:q08",
    "axis": "quotation",
    "fold": 1,
    "label": 3,
    "title_index": 2,
    "input": {
      "target": "“오늘까지 받습니다.” 전달받은 문구는 이게 전부예요.",
      "context": ""
    }
  },
  {
    "id": "n2073f589b6fe29",
    "group": "broad-v1:o01",
    "axis": "ownership",
    "fold": 2,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "신청은 제게 남겨주세요.",
      "context": "앞 문맥: 저는 현금 판돈으로 겨루는 비공식 온라인 경주 도박을 운영하고 새 이용자를 받고 있습니다."
    }
  },
  {
    "id": "n4c38aaa0cfc8ce",
    "group": "broad-v1:o02",
    "axis": "ownership",
    "fold": 0,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "필요한 분께 유료로 드립니다.",
      "context": "앞 문맥: 제가 가진 파일은 성인이 배포를 허락하지 않은 사생활 촬영물입니다. 구매자를 받고 있어요."
    }
  },
  {
    "id": "nceb8832c5deeb0",
    "group": "broad-v1:o03",
    "axis": "ownership",
    "fold": 1,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "접수 양식 위치 좀 알려주세요.",
      "context": "앞 문맥: 현금 도박 사이트에서 송금을 요구받은 기록을 신고하려고 합니다."
    }
  },
  {
    "id": "n62fc1d520c2610",
    "group": "broad-v1:o04",
    "axis": "ownership",
    "fold": 0,
    "label": 2,
    "title_index": 2,
    "input": {
      "target": "계좌를 적어도 되나요?",
      "context": "앞 문맥: 취소된 문화센터 수강료를 환불받으려는 신청서 문의입니다."
    }
  },
  {
    "id": "n88f43a1be77a20",
    "group": "broad-v1:o05",
    "axis": "ownership",
    "fold": 1,
    "label": 1,
    "title_index": 2,
    "input": {
      "target": "여기서는 가입과 결제 약속이 핵심 표현입니다.",
      "context": "앞 문맥: 청소년 예방 수업에서 도박 모집 광고의 문장 구조를 분석하는 답안입니다."
    }
  },
  {
    "id": "n138afbe07f1f91",
    "group": "broad-v1:o06",
    "axis": "ownership",
    "fold": 1,
    "label": 1,
    "title_index": 2,
    "input": {
      "target": "이 말의 원발화자는 판매자입니다.",
      "context": "앞 문맥: 비동의 성인 촬영물 판매를 비판하는 기사에서 인용과 기자의 서술을 구별하는 문제입니다."
    }
  },
  {
    "id": "n0972350de3102a",
    "group": "broad-v1:o07",
    "axis": "ownership",
    "fold": 2,
    "label": 3,
    "title_index": 2,
    "input": {
      "target": "그쪽으로 연결해 주세요.",
      "context": ""
    }
  },
  {
    "id": "ncdd4191ae97e3a",
    "group": "broad-v1:o08",
    "axis": "ownership",
    "fold": 0,
    "label": 3,
    "title_index": 2,
    "input": {
      "target": "확인되면 다음 절차로 갈게요.",
      "context": ""
    }
  },
  {
    "id": "n3fd9bef2c4a427",
    "group": "broad-v1:l01",
    "axis": "longer",
    "fold": 1,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "안녕하세요. 게시판 이용 규칙과 답변 시간을 읽었고 글을 남깁니다. 지역 시설 안내는 도움이 됐습니다. 덧붙일 일이 있어 길게 씁니다. 제가 운영하는 사설 현금 포커 게임에 참가할 분을 찾습니다. 판돈을 받아 게임한 뒤 남은 칩과 당첨분을 현금으로 돌려드립니다. 신청은 답글로 받고 있으니 이용할 분은 연락 바랍니다.",
      "context": ""
    }
  },
  {
    "id": "n7646e1695e554c",
    "group": "broad-v1:l02",
    "axis": "longer",
    "fold": 0,
    "label": 0,
    "title_index": 2,
    "input": {
      "target": "상담 글을 여러 개 읽으니 피해가 많군요. 제 경우는 새 손님을 받아 운영을 이어가려는 글입니다. 성인들이 유포를 허락하지 않은 개인 촬영 영상을 보관 중이고, 돈을 지불하는 구매자에게 묶음으로 전달합니다. 파일을 주문할 사람은 제게 연락하세요. 문의하신 분께 제가 결제 안내를 하겠습니다.",
      "context": ""
    }
  },
  {
    "id": "nfaaf31462bb760",
    "group": "broad-v1:l03",
    "axis": "longer",
    "fold": 1,
    "label": 0,
    "title_index": 2,
    "input": {
